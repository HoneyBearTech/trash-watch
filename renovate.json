{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security", "openssf"]
  },
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "schedule": ["before 6am on monday"],
  "timezone": "America/Chicago",
  "packageRules": [
    {
      "description": "An image rebuild (a new digest under the same tag) doesn't wait: Docker Hub dates it by the tag's last push, so a tag rebuilt about weekly would restart the 3-day clock each time and never get through the Monday-only schedule. Only images: a moved tag on an Action keeps the wait.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch dependencies"
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    },
    {
      "description": "Keep the Python version of the fuzz workflow below 3.15: Atheris has no Python 3.15 wheels yet (newest release 3.1.0 has cp312-cp314 only), so fuzz jobs would fail to install it. Remove this rule once Atheris publishes cp315 wheels.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/fuzz.yml"],
      "matchDepNames": ["python"],
      "matchDepTypes": ["uses-with"],
      "allowedVersions": "<3.15"
    }
  ],
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "github-actions",
    "gitlabci",
    "pip_requirements",
    "custom.regex"
  ],
  "pip_requirements": {
    "managerFilePatterns": ["/^requirements(?:-[^/]+)?\\.(?:in|txt)$/"]
  },
  "gitlabci": {
    "managerFilePatterns": ["/^\\.gitlab-ci\\.yml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/scan\\.yml$/"],
      "matchStrings": ["image: \\\"(?<depName>ghcr\\.io/honeybeartech/trash-watch):(?<currentValue>[^\\\"]+)\\\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.env\\.example$/"],
      "matchStrings": ["# TRASH_WATCH_IMAGE=ghcr\\.io/honeybeartech/trash-watch:(?<currentValue>[^\\s]+)"],
      "depNameTemplate": "ghcr.io/honeybeartech/trash-watch",
      "datasourceTemplate": "docker"
    }
  ]
}
