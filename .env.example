# trash-watch settings. Copy to .env, which is gitignored and must never be committed:
#   cp .env.example .env && chmod 600 .env
# docker compose uses RECYCLARR_CONFIG_PATH for the volume mount and passes every line below
# into the container. Empty values are fine.

# Host path of Recyclarr's app-data directory: the same directory the Recyclarr container
# mounts as /config (it holds recyclarr.yml and/or configs/ and includes/).
# Always mounted read-only. Required.
RECYCLARR_CONFIG_PATH=/path/to/recyclarr/config

# Hours between checks.
INTERVAL_HOURS=24

# Notifications: set one or both. With neither, findings go to the container log only.
# These are secrets: anyone holding the URL can post to the topic or channel.
NTFY_URL=
DISCORD_WEBHOOK=

# Optional: a URL pinged (GET) after every completed check, for a dead man's switch such as an Uptime Kuma
# Push monitor or healthchecks.io: you're alerted when the pings stop. Also a secret (it carries a token).
# HEARTBEAT_URL=https://uptime-kuma.example/api/push/<token>?status=up&msg=OK&ping=

# Optional: map a profile name in your config to a TRaSH Guides quality profile (its trash_id,
# or its exact guide name), for guide profiles you renamed. One line of JSON. Profiles are
# otherwise matched by name, then by a score_set only one guide profile uses; the log lists any
# profile that matched nothing and so wasn't checked.
# PROFILE_MAP='{"Movies 4K": "5128baeb2b081b72126bc8482b2a86a0", "My 1080p": "[SQP] SQP-1 (1080p)"}'

# Optional: things you skip on purpose, comma-separated. A trash_id (CF or guide profile) is
# ignored everywhere; a profile name skips that profile. No quotes, no comments on the line.
# IGNORE=dc98083864ea246d05a42df0d05f81cc,My Custom Profile

# The unprivileged user and group the container runs as. They must own ./data on the host (mkdir -p data as
# that user). Defaults: 1000, the first user on most Linux hosts; check yours with `id -u` and `id -g`.
# TRASH_WATCH_UID=1000
# TRASH_WATCH_GID=1000

# Optional: run a signed release image instead of building from this checkout
# (docs/verifying-releases.md shows how to check its signature first).
# TRASH_WATCH_IMAGE=ghcr.io/honeybeartech/trash-watch:0.1.1
# TRASH_WATCH_PULL_POLICY=always

# Don't set RUN_ONCE here. With restart: unless-stopped the container would start again
# straight after every exit. For a one-time test:
#   docker compose run --rm -e RUN_ONCE=1 trash-watch
